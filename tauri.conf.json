{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiyane",
  "version": "0.0.4",
  "identifier": "com.usongon.shiyane",
  "build": {
    "beforeDevCommand": { "script": "npm install && npm run dev", "cwd": "src-ui" },
    "beforeBuildCommand": { "script": "npm install && npm run build", "cwd": "src-ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "./src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾言 - Shiyane",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      },
      {
        "label": "subtitle-overlay",
        "title": "",
        "url": "/?window=overlay",
        "width": 600,
        "height": 190,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
